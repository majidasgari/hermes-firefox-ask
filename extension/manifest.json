{
  "manifest_version": 3,
  "name": "پرسش از هرمس",
  "version": "1.1.0",
  "description": "بخشی از صفحه یا کل آن را انتخاب کن و از هرمس بپرس؛ پاسخ در نوار کناری می‌آید.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hermes-ask@maxv.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8790/*"],
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "پرسش از هرمس",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "open_at_install": true,
    "default_area": "navbar"
  },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "باز کردن نوار کناری پرسش از هرمس"
    }
  }
}
